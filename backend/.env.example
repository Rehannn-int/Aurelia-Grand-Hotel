NODE_ENV=development
PORT=4000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
MONGODB_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_DB_PASSWORD>@<CLUSTER_HOST>/aurelia_grand
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
HOTEL_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Local development only — demo admin bootstrap for college-project testing.
# Never set these in production. The script refuses to run when NODE_ENV=production.
DEMO_ADMIN_NAME=Aurelia Grand Admin
DEMO_ADMIN_EMAIL=admin@aureliagrand.local
DEMO_ADMIN_PASSWORD=AureliaDemo2026!

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aurelia Grand <no-reply@example.invalid>
